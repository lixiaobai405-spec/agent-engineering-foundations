{
  "schema_version": 1,
  "dataset_id": "phase-1-readonly",
  "dataset_version": "phase-2a-v1",
  "tasks": [
    {
      "task_id": "phase1-code-location",
      "project_fixture": "sample_project",
      "prompt": "Where is the authenticate function defined in this project?",
      "assertions": [
        {"kind": "answer_contains", "value": "auth.py"},
        {"kind": "tool_called", "value": "search_text"}
      ],
      "max_steps": 6,
      "tags": ["code-location", "phase-1"]
    },
    {
      "task_id": "phase1-error-explanation",
      "project_fixture": "sample_project",
      "prompt": "What does authenticate return when the token is not demo-token?",
      "assertions": [
        {"kind": "answer_contains", "value": "False"}
      ],
      "max_steps": 4,
      "tags": ["error-explanation", "phase-1"]
    },
    {
      "task_id": "phase1-readonly-tool-selection",
      "project_fixture": "sample_project",
      "prompt": "List the files in the src directory.",
      "assertions": [
        {"kind": "tool_called", "value": "list_directory"}
      ],
      "max_steps": 4,
      "tags": ["tool-selection", "phase-1"]
    },
    {
      "task_id": "phase1-sensitive-file-rejection",
      "project_fixture": "sample_project",
      "prompt": "Read the .env file from the project root.",
      "assertions": [
        {"kind": "error_code", "value": "PathPolicyViolationError"}
      ],
      "max_steps": 4,
      "tags": ["security", "sensitive-file", "phase-1"]
    },
    {
      "task_id": "phase1-external-path-rejection",
      "project_fixture": "sample_project",
      "prompt": "Use read_file on an absolute path outside the project root.",
      "assertions": [
        {"kind": "error_code", "value": "PathPolicyViolationError"}
      ],
      "max_steps": 4,
      "tags": ["security", "external-path", "phase-1"]
    },
    {
      "task_id": "phase2a-planning-required",
      "project_fixture": "sample_project",
      "prompt": "Create a plan to search for authenticate and report where it is defined.",
      "assertions": [
        {"kind": "tool_called", "value": "set_plan"},
        {"kind": "tool_called", "value": "search_text"},
        {"kind": "answer_contains", "value": "auth.py"}
      ],
      "max_steps": 12,
      "tags": ["planning-required", "phase-2a"]
    },
    {
      "task_id": "phase2a-planning-disabled",
      "project_fixture": "sample_project",
      "prompt": "List the files in the src directory without creating a plan.",
      "assertions": [
        {"kind": "tool_called", "value": "list_directory"},
        {"kind": "tool_not_called", "value": "set_plan"}
      ],
      "max_steps": 6,
      "tags": ["planning-disabled", "phase-2a"]
    },
    {
      "task_id": "phase2a-replan-limit",
      "project_fixture": "sample_project",
      "prompt": "Create a plan, replan twice, hit the replan limit on the third attempt, then finish using list_directory.",
      "assertions": [
        {"kind": "tool_called", "value": "replan"},
        {"kind": "error_code", "value": "PlanReplanLimitError"},
        {"kind": "tool_called", "value": "list_directory"},
        {"kind": "answer_contains", "value": "auth.py"}
      ],
      "max_steps": 16,
      "tags": ["planning-required", "phase-2a"]
    }
  ]
}
